{
  "name": "cloud-cache-action",
  "version": "1.0.0",
  "description": "High-performance GitHub Action caching to any S3-compatible storage with actions/cache v4-v6 parity",
  "main": "dist/restore/index.js",
  "scripts": {
    "build": "tsc --noEmit && ncc build -o dist/restore src/restore.ts && ncc build -o dist/save src/save.ts && ncc build -o dist/restore-only src/restoreOnly.ts && ncc build -o dist/save-only src/saveOnly.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:unit": "jest tests/unit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhiichuk/cloud-cache-action.git"
  },
  "keywords": [
    "actions",
    "github-actions",
    "cache",
    "s3",
    "r2",
    "gcs",
    "backblaze-b2",
    "fastly",
    "garage",
    "seaweedfs",
    "minio"
  ],
  "author": {
    "name": "Yurii Serhiichuk",
    "email": "yurii@serhiichuk.dev",
    "url": "https://serhiichuk.dev"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^4.0.0",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/lib-storage": "^3.750.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "aws-sdk-client-mock": "^4.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=20"
  }
}
